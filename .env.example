# ── Client port (host-side) ───────────────────────────────────────────────────
CLIENT_PORT=80

# ── Public URL (used for CORS and OAuth redirects) ────────────────────────────
CLIENT_URL=http://localhost:80

# ── Firebase client config (baked into client bundle at build time) ───────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side secrets live in server/.env (not here).
# See server/.env.example for those.
