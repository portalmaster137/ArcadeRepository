app.porta137.com {
    root * /data/ArcadeQueueClient
    encode gzip zstd

    # SPA fallback: any path that doesn't match a real file in /srv →
    # index.html. Vite's content-addressed assets live under /assets/ and
    # always match first, so the fallback only kicks in for client routes.
    try_files {path} {path}/ /index.html

    file_server

    # Don't cache index.html itself — it has the script tag pointing at
    # /assets/index-*.js, which is content-addressed. The script tag changes
    # on every deploy, but the script body never does. Caching index.html
    # would break deploys.
    header Cache-Control "no-cache"
    header X-Content-Type-Options "nosniff"
    header Access-Control-Allow-Origin "https://api.porta137.com"

    # Vite's /assets/* filenames are content-hashed, so they're safe to
    # cache forever. This is the standard SPA cache strategy.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
}

# ── API ──
api.porta137.com {
        header {
                Access-Control-Allow-Origin "https://app.porta137.com"
                Access-Control-Allow-Credentials true
        }
    reverse_proxy 127.0.0.1:39170 {
        header_down -Access-Control-Allow-Origin
    }
}
